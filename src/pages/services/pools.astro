---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import CtaBanner from '../../components/sections/CtaBanner.astro';
import { faqSchema, serviceSchema } from '../../lib/seo';
import { SITE } from '../../lib/site-config';
const faqItems = [
  { q: 'How long does installation take?', a: '2–4 weeks from delivery to swim-ready. This includes site prep, foundation, frame assembly, and system testing. Welded steel pools may take longer if in-ground excavation is required.' },
  { q: 'What\'s the lifespan of each pool type?', a: 'Tube steel + fiberglass: 20+ years. Welded steel + epoxy: 20+ years. Both can be refurbished or upgraded if needed.' },
  { q: 'Can I customize the size?', a: 'Yes. Standard sizes are available, but we build custom pools too. Custom sizes may take longer and cost more. Ask during your quote.' },
  { q: 'Do you offer financing?', a: 'Yes. Construction loans, cash payment plans, and financing partnerships available. See our Financing page or contact Dylan.' },
  { q: 'What is a modular pool?', a: 'A modular pool is fabricated in a factory and delivered ready to install. SaltGrass builds two designs: a tube steel frame with a fiberglass insert for above-ground installation, and a 7-gauge welded steel frame with an epoxy liner for in-ground installation. Installation takes 2–4 weeks from delivery to swim-ready.' },
  { q: 'How much does a modular pool cost?', a: 'A SaltGrass modular pool starts at $48,000 for the tube steel and fiberglass design and $52,000 for the welded steel and epoxy design. Both prices are all-in, covering fabrication, delivery and installation.' },
  { q: 'Do you build a modular swimming pool for a backyard?', a: 'Yes. The tube steel and fiberglass design comes in standard 20, 25 and 30 foot sizes at a typical depth of 3.5–4 feet, and custom sizes are available. The welded steel design is built in-ground, with depths up to 5 feet.' },
  { q: 'Is there an above ground modular pool?', a: 'Yes. Our tube steel frame and fiberglass insert design is an above-ground installation, with a galvanized steel frame and a smooth fiberglass interior built to last 20+ years.' },
  { q: 'What is a modular fiberglass pool?', a: 'Our modular fiberglass pool pairs a galvanized steel tube frame with a smooth fiberglass interior. It is the most popular SaltGrass pool design, with a 2-year frame warranty and a 5-year fiberglass warranty.' },
];
const pageDescription = "Factory-built modular pools with two design options: tube steel + fiberglass or welded steel + epoxy liner. Fast installation, durable, transparent pricing.";
const pageUrl = new URL(Astro.url.pathname, SITE.url).href;
---

<BaseLayout
  title="Modular Pools - SaltGrass Modular"
  description={pageDescription}
  schemas={[faqSchema(faqItems), serviceSchema({ name: "Modular Pools", description: pageDescription, url: pageUrl })]}
>
  <Hero
    eyebrow="Modular Pools"
    headline="Beautiful Pools. Built Fast."
    subhead="Two proven designs. Factory-built quality. Professional installation. Starting at $48K."
    image="/img/projects/shipping-container-pool-epoxy-liner-two-20ft-containers.webp"
  />

  <!-- Pool Options -->
  <section class="py-section-y">
    <div class="container">
      <h2 class="text-4xl font-bold text-ink-900 mb-12 text-center">Two Proven Designs</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Tube Steel + Fiberglass -->
        <div class="bg-white border-2 border-brand-primary rounded-2xl p-8">
          <img src="/img/projects/tube-steel-modular-pool-fiberglass-fabrication.webp" alt="Tube steel frame modular pool with fiberglass insert in fabrication" loading="lazy" class="w-full h-48 object-cover rounded-lg mb-4" />
          <h3 class="text-2xl font-bold text-ink-900 mb-4">Tube Steel Frame + Fiberglass Insert</h3>
          <p class="text-ink-700 mb-6">
            Our most popular design. Durable galvanized steel frame with smooth fiberglass interior. Easy maintenance, attractive appearance, built to last 20+ years.
          </p>

          <div class="bg-ink-50 rounded-lg p-4 mb-6">
            <h4 class="font-bold text-ink-900 mb-3">Specifications:</h4>
            <ul class="space-y-2 text-sm text-ink-700">
              <li>• Frame: Galvanized steel tube (maintenance-free)</li>
              <li>• Interior: Fiberglass (smooth, durable)</li>
              <li>• Above-ground installation</li>
              <li>• Standard sizes: 20', 25', 30'</li>
              <li>• Depth: 3.5–4' typical</li>
              <li>• Warranty: 2 years frame, 5 years fiberglass</li>
            </ul>
          </div>

          <div class="mb-6">
            <p class="text-3xl font-bold text-brand-primary">Starting at $48,000</p>
            <p class="text-sm text-ink-600 mt-1">All-in: fabrication, delivery &amp; installation</p>
          </div>

          <button type="button" data-action="quote-modal" class="w-full btn-primary">Request Quote</button>
        </div>

        <!-- Welded Steel + Epoxy Liner -->
        <div class="bg-white border-2 border-brand-primary rounded-2xl p-8">
          <img src="/img/projects/welded-steel-epoxy-pool-8x30-rendering.webp" alt="7-gauge welded steel pool with epoxy liner, 8 ft by 30 ft, shown in a backyard rendering" loading="lazy" class="w-full h-48 object-cover rounded-lg mb-4" />
          <h3 class="text-2xl font-bold text-ink-900 mb-4">7-Gauge Welded Steel + Epoxy Liner</h3>
          <p class="text-ink-700 mb-6">
            Premium in-ground option. Welded steel frame with epoxy liner. Built to last 20+ years. Perfect for permanent installations.
          </p>

          <div class="bg-ink-50 rounded-lg p-4 mb-6">
            <h4 class="font-bold text-ink-900 mb-3">Specifications:</h4>
            <ul class="space-y-2 text-sm text-ink-700">
              <li>• Frame: 7-gauge welded steel (commercial-grade)</li>
              <li>• Interior: Food-grade epoxy liner</li>
              <li>• In-ground installation</li>
              <li>• Custom sizes available</li>
              <li>• Depth: Up to 5'</li>
              <li>• Warranty: 10 years frame, 15 years epoxy</li>
            </ul>
          </div>

          <div class="mb-6">
            <p class="text-3xl font-bold text-brand-primary">Starting at $52,000</p>
            <p class="text-sm text-ink-600 mt-1">All-in: fabrication, delivery &amp; installation</p>
          </div>

          <button type="button" data-action="quote-modal" class="w-full btn-primary">Request Quote</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="py-section-y bg-ink-50">
    <div class="container">
      <h2 class="text-3xl font-bold text-ink-900 mb-8 text-center">Which Pool Is Right for You?</h2>
      <div class="max-w-4xl mx-auto overflow-x-auto">
        <table class="w-full bg-white rounded-2xl overflow-hidden shadow-soft">
          <thead class="bg-brand-primary text-white">
            <tr>
              <th class="px-6 py-4 text-left font-bold">Feature</th>
              <th class="px-6 py-4 text-center font-bold">Tube Steel + Fiberglass</th>
              <th class="px-6 py-4 text-center font-bold">Welded Steel + Epoxy</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-ink-200">
            <tr class="hover:bg-ink-50">
              <td class="px-6 py-4 font-semibold">Installation Type</td>
              <td class="px-6 py-4 text-center">Above-ground</td>
              <td class="px-6 py-4 text-center">In-ground</td>
            </tr>
            <tr class="hover:bg-ink-50">
              <td class="px-6 py-4 font-semibold">Durability</td>
              <td class="px-6 py-4 text-center">20+ years</td>
              <td class="px-6 py-4 text-center">20+ years</td>
            </tr>
            <tr class="hover:bg-ink-50">
              <td class="px-6 py-4 font-semibold">Maintenance</td>
              <td class="px-6 py-4 text-center">Seasonal cover, standard</td>
              <td class="px-6 py-4 text-center">Minimal</td>
            </tr>
            <tr class="hover:bg-ink-50">
              <td class="px-6 py-4 font-semibold">Starting Price</td>
              <td class="px-6 py-4 text-center">$48K</td>
              <td class="px-6 py-4 text-center">$52K</td>
            </tr>
            <tr class="hover:bg-ink-50">
              <td class="px-6 py-4 font-semibold">Best For</td>
              <td class="px-6 py-4 text-center">Families, seasonal use, budget-conscious</td>
              <td class="px-6 py-4 text-center">Permanent, high-use, long-term investment</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- What's Included -->
  <section class="py-section-y">
    <div class="container">
      <h2 class="text-3xl font-bold text-ink-900 mb-8 text-center">What's Included in Your Pool</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-3xl mx-auto">
        <div>
          <h3 class="font-bold text-ink-900 mb-4">Included:</h3>
          <ul class="space-y-2">
            {[
              'Pool frame (galvanized steel or welded steel)',
              'Interior finish (fiberglass or epoxy)',
              'Circulation system (pump, filter, plumbing)',
              'Skimmer and drain system',
              'Site delivery and installation labor',
              'Initial fill and system testing',
              'Owner\'s manual and maintenance guide',
            ].map(item => (
              <li class="flex gap-3">
                <span class="text-brand-primary font-bold">✓</span>
                <span class="text-ink-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div>
          <h3 class="font-bold text-ink-900 mb-4">Not Included (Optional Add-ons):</h3>
          <ul class="space-y-2">
            {[
              'Deck or surround construction',
              'Heating system (gas or electric)',
              'Automation/smart controls',
              'Lighting',
              'Diving board or water features',
              'Pool cover',
              'Ongoing maintenance service',
            ].map(item => (
              <li class="flex gap-3">
                <span class="text-ink-600">•</span>
                <span class="text-ink-700">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-section-y bg-ink-50">
    <div class="container">
      <h2 class="text-3xl font-bold text-ink-900 mb-12 text-center">Pool FAQs</h2>
      <div class="max-w-3xl mx-auto space-y-6">
        {faqItems.map((item) => (
          <div class="bg-white rounded-xl p-6">
            <h3 class="font-bold text-ink-900 mb-3">{item.q}</h3>
            <p class="text-ink-700">
              {item.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CtaBanner
    headline="Ready to Build Your Dream Pool?"
    subhead="Get a free quote and compare our two pool designs."
  />
</BaseLayout>
